# ============================================================================
# Unified environment for the whole stack. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit a real key.
#
# HOW THIS FILE IS READ
#   - docker compose        reads it directly (`env_file: .env`)
#   - bare `uvicorn` runs   each service's config.py declares
#                           env_file=("../../.env", ".env")
#                           Order matters: pydantic-settings gives precedence to the
#                           LAST file, so THIS file is the fallback and a service's own
#                           .env overrides it. The reverse order would silently let the
#                           root file win over a service's own settings.
#
# PORTS — fixed repo-wide, do not change casually
#   merchant 8001 · agent 8002 · payments 8003 · stubs 9001 · postgres 5433 (host) / 5432 (in-compose)
# ============================================================================


# ---------------------------------------------------------------------------
# LLM inference — agent only
# ---------------------------------------------------------------------------
# Needed for: the ingestion classify step, and agent conversation.
# NOT needed for: the agent's 312 tests, which run with no key and no network.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Only used when LLM_PROVIDER=anthropic. Leave blank otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

LLM_TIMEOUT_SECONDS=90


# ---------------------------------------------------------------------------
# Embeddings — agent only
# ---------------------------------------------------------------------------
# `ollama` needs Ollama running locally (`ollama serve`). A dead Ollama degrades
# search_catalog to structured-filter-only under a hard timeout rather than hanging,
# but the demo is much weaker without vectors.
# EMBEDDING_PROVIDER=openai is the one-line escape hatch.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_TIMEOUT_SECONDS=20


# ---------------------------------------------------------------------------
# Service wiring
# ---------------------------------------------------------------------------
# Point the agent at the REAL services. To fall back to the single stub that serves
# both contracts (`cd services/agent && uv run uvicorn stubs.mock_services:app --port 9001`),
# set both of these to http://localhost:9001
MERCHANT_BASE_URL=http://localhost:8001
PAYMENT_BASE_URL=http://localhost:8003

# Inside docker compose, services reach each other by service name instead:
#   MERCHANT_BASE_URL=http://merchant:8001
#   PAYMENT_BASE_URL=http://payments:8003


# ---------------------------------------------------------------------------
# Databases — one Postgres instance, two databases
# ---------------------------------------------------------------------------
# `docker compose up -d db` provides these. Payments will NOT start without its
# database: init_pool() runs in its lifespan.
#
# The merchant reads MERCHANT_DATABASE_URL first and falls back to DATABASE_URL.
# Both are set here because they must point at DIFFERENT databases — leaving
# MERCHANT_DATABASE_URL blank would silently put merchant data in the payments db.
# Leave MERCHANT_DATABASE_URL blank ONLY if you deliberately want the merchant's
# in-memory store (which loses the catalog on every restart).
# HOST PORT IS 5433, NOT 5432. A native PostgreSQL service owns 5432 on this machine
# and on Windows it shadows the container's publish silently — `docker ps` claims 5432
# is published while host connections land on the native server and fail password auth.
# DB_HOST_PORT feeds docker-compose.yml; keep it in step with the two URLs below.
DB_HOST_PORT=5433

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/payments
MERCHANT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/merchant

# Inside docker compose, the host is the service name and the port is the internal one:
#   DATABASE_URL=postgresql://postgres:postgres@db:5432/payments
#   MERCHANT_DATABASE_URL=postgresql://postgres:postgres@db:5432/merchant

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# GET /health on the merchant reports {"storage": "postgres" | "memory"} so you can
# always see which store you are actually talking to.


# ---------------------------------------------------------------------------
# Merchant backend
# ---------------------------------------------------------------------------
# Seeds fixtures/eyewear_mock_data.csv as merchant_id `eyewear_co` on startup.
SEED_ON_STARTUP=true
CORS_ORIGINS=*


# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
VISA_MODE=mock
# Payments is AUTHORITATIVE for expiry — it is the side that refuses the charge.
# The agent's PREVIEW_TTL_SECONDS below is only a fallback for stub runs.
PAYMENT_TTL_MINUTES=15


# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
MAX_PROBES_PER_TURN=1
MAX_PROBES_PER_SESSION=4
MAX_TOOL_ROUNDS=5
SEARCH_MIN_RESULTS=4
SEARCH_TOP_K=6

# Fallback only — see PAYMENT_TTL_MINUTES above.
PREVIEW_TTL_SECONDS=300

DATA_DIR=./data
