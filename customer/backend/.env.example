# LLM inference
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Embeddings
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_TIMEOUT_SECONDS=20

# Downstream services (point at stubs until the other teams are ready)
MERCHANT_BASE_URL=http://localhost:9001
PAYMENT_BASE_URL=http://localhost:9001

# Agent behaviour
MAX_PROBES_PER_TURN=2
MAX_PROBES_PER_SESSION=4
MAX_TOOL_ROUNDS=5
PREVIEW_TTL_SECONDS=300
SEARCH_MIN_RESULTS=3
SEARCH_TOP_K=6

# Storage
DATA_DIR=./data
